# Earth Jukebox Environment Configuration
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://localhost:8000,http://127.0.0.1:8000,null

# NASA Service Credentials (Optional for POWER/CMR open endpoints; Required for FIRMS)
NASA_EARTHDATA_TOKEN=
NASA_FIRMS_MAP_KEY=your_firms_map_key_here

# Cache and Artifact Storage Settings
CACHE_DIR=./data/cache
MODEL_ARTIFACTS_DIR=./artifacts/models
EVALUATION_DIR=./artifacts/evaluations
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=3

# AI report generation (does not provide environmental datasets)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_SECONDS=30